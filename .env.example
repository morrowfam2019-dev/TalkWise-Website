# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real keys.

# Public site URL, used for canonical links, sitemap, and OG tags.
NEXT_PUBLIC_SITE_URL=https://www.talkwise.academy

# --- Brevo (email + SMS) -----------------------------------------------
# Brevo → top-right menu → SMTP & API → API Keys → Generate a new API key.
BREVO_API_KEY=

# Brevo → Contacts → Lists. The number shown in the list's URL/ID column.
BREVO_LIST_ID=

# Until both values above are set, signups are written to the server log
# instead of Brevo, so nothing is lost while you finish setup.
